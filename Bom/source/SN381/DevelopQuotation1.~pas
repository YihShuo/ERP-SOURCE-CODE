procedure TDevelopQuotation.SaveBtn(Query:TQuery;Cancel:TMenuItem;Save:TMenuItem);
var i:integer;
begin
    with Query do
    begin
      first;
      while not eof do
      begin
        if (Query.fieldbyname('SamplePrice').Value<>Query.fieldbyname('SamplePrice').OldValue) then
        begin
          with TemQry do
          begin
            active:=false;
            sql.Clear;
            sql.Add(' select CLBH,GSBH from MaterialCBD where CLBH='''+Query.fieldbyname('CLBH').AsString+'''');
            active:=true;
            if eof then
            begin
              active:=false;
              sql.Clear;
              sql.Add(' insert MaterialCBD (CLBH,GSBH,ZSBH,Season,SamplePrice,userID,userdate,YN');
              sql.Add(') values (');
              sql.Add(' '''+Query.fieldbyname('CLBH').AsString+'''');
              sql.Add(','''+main.edit2.Text+'''');
              sql.Add(','''+Query.fieldbyname('ZSDH').AsString+'''');
              sql.Add(','''+Query.fieldbyname('Season').AsString+''',');
              sql.Add(''''+Query.fieldbyname('SamplePrice').AsString+''',');
              sql.Add(''''+main.edit1.text+'''');
              sql.Add(','''+formatdatetime('yyyy/MM/dd',Ndate)+'''');
              sql.Add(',1)');
              execsql;
            end
            else
            begin
              if main.edit2.Text=TemQry.FieldByName('GSBH').AsString then
              begin
                active:=false;
                sql.Clear;
                sql.Add(' update MaterialCBD set ');
                if Query.fieldbyname('SamplePrice').IsNull then
                  sql.Add(' SamplePrice=null')
                else
                  sql.Add(' SamplePrice='''+Query.fieldbyname('SamplePrice').AsString+'''');
                sql.Add('   ,ZSBH='''+Query.fieldbyname('ZSDH').AsString+''' ');
                sql.Add('   ,userID='''+main.edit1.text+'''');
                sql.Add('   ,userdate='''+formatdatetime('yyyy/MM/dd',Ndate)+'''');
                sql.Add(' where CLBH = '''+Query.fieldbyname('CLBH').AsString+'''');
                execsql;
              end else
              begin
                active:=false;
                showmessage('Department not the same ');
                abort;
              end;
            end;
          end;
        end;
        next;
      end;
    end;
    Query.active:=false;
    Query.cachedupdates:=false;
    Query.requestlive:=false;
    Query.active:=TRUE;
    Cancel.Enabled:=false;
    Save.enabled:=false;
end;


