procedure TDevelopQuotation.bbt6Click(Sender: TObject);
var  eclApp,WorkBook:olevariant;
     i,j:integer;
 begin
  if MainPC.ActivePageIndex=1 then
  begin
    if  XXZLS.active  then
    begin
    try
      eclApp:=CreateOleObject('Excel.Application');
      WorkBook:=CreateOleObject('Excel.Sheet');
    except
      Application.MessageBox('No Microsoft   Excel','Microsoft   Excel',MB_OK+MB_ICONWarning);
      Exit;
    end;
    try
        WorkBook:=eclApp.workbooks.Add;
        for   i:=0   to   XXZLS.fieldcount-1   do
        begin
            eclApp.Cells(1,i+1):=XXZLS.fields[i].FieldName;
        end;

        XXZLS.First;
        j:=2;
        while   not   XXZLS.Eof   do
        begin
          for   i:=0   to  XXZLS.fieldcount-1  do
          begin
            eclApp.Cells(j,i+1):=XXZLS.Fields[i].Value;
          end;
        XXZLS.Next;
        inc(j);
        end;
       eclapp.columns.autofit;
       showmessage('Succeed');
       eclApp.Visible:=True;

      except
        on   F:Exception   do
          showmessage(F.Message);
      end;
    end;
  end else
  if MainPC.ActivePageIndex=0 then
  begin
    if  XXMQ.active  then
    begin
    try
      eclApp:=CreateOleObject('Excel.Application');
      WorkBook:=CreateOleObject('Excel.Sheet');
    except
      Application.MessageBox('No Microsoft   Excel','Microsoft   Excel',MB_OK+MB_ICONWarning);
      Exit;
    end;
    try
        WorkBook:=eclApp.workbooks.Add;
        for   i:=0   to   XXMQ.fieldcount-1   do
        begin
            eclApp.Cells(1,i+1):=XXMQ.fields[i].FieldName;
        end;

        XXMQ.First;
        j:=2;
        while   not   XXMQ.Eof   do
        begin
          for   i:=0   to  XXMQ.fieldcount-1  do
          begin
            eclApp.Cells(j,i+1):=XXMQ.Fields[i].Value;
          end;
        XXMQ.Next;
        inc(j);
        end;
       eclapp.columns.autofit;
       showmessage('Succeed');
       eclApp.Visible:=True;

      except
        on   F:Exception   do
          showmessage(F.Message);
      end;
    end;
  end;

end;


