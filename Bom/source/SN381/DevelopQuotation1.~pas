procedure TDevelopQuotation.Button1Click(Sender: TObject);
begin
  if (SeasonEdit.text='') and (edit3.text='')and (BuyNoEdit.Text='') then
   begin
         showmessage('Please input season or Article or Customer keypoint ');
   end else
   begin
       XXZLS.Active:=false;
       with XXZL do
       begin
         active:=false;
         sql.clear;
         sql.add('select XXZL.XieXing,XXZL.SheHao,XXZL.Article,xxzls.XieXing as XX,xxzls.SheHao as SS,');
         sql.add('XXZL.XieMing,XXZL.YSSM,KFZL.KFJC,XXZL.BZCC,XXZL.IMGName,KFXXZL.JiJie,XXZL.DAOMH,KFXXZL.DEVCODE from XXZL ');
         sql.add('left join KFZL on KFZL.KFDH=XXZL.KHDH ');
         sql.add('left join KFXXZL on KFXXZL.SheHao=XXZL.SheHao and  KFXXZL.XieXing=XXZL.XieXing ');
         //
         sql.Add('left join(select XXZLS.XieXing,XXZLS.SheHao');
         sql.Add('          FROM XXZLS left join xxzl on xxzl.XieXing=xxzls.XieXing and xxzl.SheHao=xxzls.SheHao');
         sql.Add('          LEFT JOIN CLZL ON XXZLS.CLBH = CLZL.cldh');
         sql.Add('          LEFT JOIN ZSZL on ZSZL.ZSDH=XXZLS.CSBH');
         sql.Add('          LEFT JOIN ZSZL_DEV ON ZSZL_DEV.ZSDH=XXZLS.CSBH AND ZSZL_DEV.GSBH=''CDC''');
         sql.Add('          LEFT JOIN (select* ');
         sql.Add('                     from ( select *,ROW_NUMBER() over (PARTITION BY CLBH,ZSBH ORDER BY Substring(Season,1,2) DESC,Substring(Season,3,1) ASC) as  rn ');
         sql.Add('                            from MaterialCBD where  CLBH not like ''V%'' ');
         sql.Add('                           ) A where A.rn=1  ) MaterialCBD ON MaterialCBD.CLBH=XXZLS.CLBH and MaterialCBD.ZSBH=xxzls.CSBH');
         sql.Add('          where  xxzl.ARTICLE like '+''''+edit3.Text+'%'+''' and CLZMLB=''N''');
