         sql.add('where XXZL.XieXing like '+''''+edit1.Text+'%'+'''');
         sql.add(' and XXZL.SheHao like '+''''+edit2.Text+'%'+'''');
         sql.add(' and XXZL.ARTICLE like '+''''+edit3.Text+'%'+'''');
